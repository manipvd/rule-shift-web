{
  // Cloudflare Workers static-assets deployment.
  // Usage: npm run build && npx wrangler deploy
  // (If you `npm i -D wrangler`, add "$schema": "node_modules/wrangler/config-schema.json" for validation.)
  "name": "rule-shift-web",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
